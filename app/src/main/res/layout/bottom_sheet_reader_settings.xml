<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Reading settings"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Brightness"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/seekbarBrightness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100" />

    <LinearLayout
        android:id="@+id/layoutFontSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Text size (EPUB)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekbarFontSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="20"
            android:progress="8" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchNightMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Night mode"
        android:textColor="@color/text_primary" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Page-flip sound"
        android:textColor="@color/text_primary" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchTwoPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Two-page book view (landscape)"
        android:textColor="@color/text_primary" />
</LinearLayout>
